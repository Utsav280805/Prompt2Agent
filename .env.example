# ======================================================================================
# multi-agent-generator - example configuration
#
# Copy this file to `.env` and fill in what you need:
#
#     cp .env.example .env
#
# `.env` is gitignored. This file is not - so never put a real key in here.
#
# Nothing below is mandatory. With no .env at all the app still runs: pick the `mock`
# provider and the whole pipeline works offline with no key, no network and no cost.
# ======================================================================================


# ---------------------------------------------------------------------------- provider
# Which LLM designs your agents. One of:
#   openai | anthropic | google | groq | huggingface | huggingface-local | ollama |
#   watsonx | mock
DEFAULT_PROVIDER=huggingface

# Leave blank to use the provider's own default model.
DEFAULT_MODEL=

# ------------------------------------------------------------------------- credentials
# Set the ONE that matches DEFAULT_PROVIDER. The others can stay empty.
# These are read from the environment only - they are never written to the database by
# the app, and never sent to the frontend.

# Hugging Face Inference API - free tier available.
# Create a token at https://huggingface.co/settings/tokens (read access is enough).
HF_TOKEN=

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini - https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Groq - https://console.groq.com/keys
GROQ_API_KEY=

# IBM WatsonX - needs both a key and the project id. Both spellings of the key variable are
# accepted: WATSONX_API_KEY is what this app reads, WATSONX_APIKEY is what the IBM SDK reads
# inside generated code, so setting either one is enough for the generator and setting the
# second is what makes a *generated* WatsonX project run.
WATSONX_API_KEY=
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Ollama - local, no key. Change only if it is not on the default port.
OLLAMA_BASE_URL=http://localhost:11434

# Any OpenAI-compatible endpoint (vLLM, LM Studio, OpenRouter, a proxy...).
# Set this to route OpenAI-style calls somewhere else.
OPENAI_BASE_URL=

# ------------------------------------------------------------------------ LLM requests
LLM_REQUEST_TIMEOUT=120
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# ---------------------------------------------------------------------------- pipeline
# How many times generation may be reviewed and improved before giving up.
MAX_GENERATION_ITERATIONS=3

# Review score (0-10) a project must reach to be accepted.
REVIEW_PASS_SCORE=7.5

# ----------------------------------------------------------------------- execution box
# Wall-clock limits, in seconds. Every subprocess is killed - along with its whole
# process tree - when it exceeds these, so nothing can hang the app forever.
AGENT_EXECUTION_TIMEOUT=120
TEST_EXECUTION_TIMEOUT=300
DEPENDENCY_INSTALL_TIMEOUT=900

# A generated project's dependencies are installed into a directory here, never into the
# interpreter running this app - a model-authored requirements.txt must not be able to
# change the packages the server itself uses. The directory is keyed by the requirements
# content and reused, so a framework is downloaded once rather than once per run.
# Leave blank for `<DATA_DIR>/deps`. Safe to delete at any time; it will be rebuilt.
DEPS_CACHE_DIR=

# ----------------------------------------------------------------------------- storage
# Where the database, the encryption keyring and the sandbox workspaces live.
DATA_DIR=

# SQLite only. Leave blank for `<DATA_DIR>/magen.db`.
DATABASE_URL=

WORKSPACES_DIR=

# ------------------------------------------------------------------------------ server
HOST=127.0.0.1
PORT=8000

# Comma-separated origins allowed to call the API. The Vite dev server is 5173 and its
# preview server is 4173, both of which are allowed by default.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Emit logs as one JSON object per line instead of human-readable text.
LOG_JSON=false
